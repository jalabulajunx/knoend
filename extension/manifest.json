{
  "manifest_version": 3,
  "name": "OpenPager",
  "version": "0.1.1",
  "description": "Your OpenPager board follows the website you are on, and its buttons act on the page you allow.",
  "permissions": ["tabs", "nativeMessaging", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "OpenPager",
              "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
