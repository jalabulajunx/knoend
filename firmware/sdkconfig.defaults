# Universal image for ESP32-S3 boards with octal PSRAM; board specifics come from the board definition.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 4 MB: the image runs on 4, 8 and 16 MB boards (it uses only the first 4 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Console on UART0 (what a USB-serial bridge carries); also mirrored to the S3's own USB port.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Octal PSRAM (ESP32-S3R8 / N16R8 class); LVGL draw buffers live there. Quad-PSRAM boards need
# a second image variant (not built yet).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# LVGL 8: RGB565, byte-swapped for SPI panels.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

# Bluetooth LE keyboard (Bluedroid, BLE only: the ESP32-S3 has no Classic Bluetooth).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# Wi-Fi link: WebSocket server for the companion; Wi-Fi/lwIP buffers in PSRAM so Bluetooth,
# Wi-Fi and LVGL fit together in internal RAM.
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
