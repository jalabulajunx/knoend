{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jalabulajunx/knoend/spec/schemas/packet.schema.json",
  "title": "KnoEnd packet (protocol v0, draft)",
  "description": "One packet between a board and a companion. See spec/protocol.md.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "re": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "pattern": "^knoend\\.[a-z]+(\\.[a-z]+)*$"
    },
    "body": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.identity"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/identity"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.layout"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/layout"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.layout.ack"
          }
        }
      },
      "then": {
        "required": [
          "re"
        ],
        "properties": {
          "body": {
            "$ref": "#/$defs/layoutAck"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.key"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/key"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.status"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/status"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.error"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.pair"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/pair"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.pair.ack"
          }
        }
      },
      "then": {
        "required": [
          "re"
        ],
        "properties": {
          "body": {
            "$ref": "#/$defs/pairAck"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.wifi"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/wifi"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.wifi.ack"
          }
        }
      },
      "then": {
        "required": [
          "re"
        ],
        "properties": {
          "body": {
            "$ref": "#/$defs/wifiAck"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.wifi.networks"
          }
        }
      },
      "then": {
        "required": [
          "re"
        ],
        "properties": {
          "body": {
            "$ref": "#/$defs/wifiNetworks"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.image"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/image"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.image.ack"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/imageAck"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.page"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/page"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.display"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/display"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knoend.display.ack"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/displayAck"
          }
        }
      }
    }
  ],
  "$defs": {
    "slot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "packetType": {
      "type": "string",
      "pattern": "^knoend\\.[a-z]+(\\.[a-z]+)*$"
    },
    "identity": {
      "type": "object",
      "required": [
        "deviceId",
        "deviceName",
        "deviceType",
        "protocolVersion",
        "incoming",
        "outgoing"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "pattern": "^[0-9a-z-]{4,64}$"
        },
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "deviceType": {
          "enum": [
            "board",
            "companion",
            "sim"
          ]
        },
        "protocolVersion": {
          "type": "integer",
          "minimum": 0
        },
        "firmware": {
          "type": "string",
          "maxLength": 32
        },
        "board": {
          "type": "object",
          "required": [
            "profile",
            "width",
            "height",
            "grid"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "grid": {
              "description": "The largest grid the board draws legibly.",
              "$ref": "#/$defs/grid"
            },
            "statusBar": {
              "type": "boolean"
            },
            "display": {
              "description": "The theme and turn the board uses now; absent on older firmware (dark, turn 0).",
              "type": "object",
              "required": [
                "theme",
                "turn"
              ],
              "additionalProperties": false,
              "properties": {
                "theme": {
                  "enum": [
                    "dark",
                    "white",
                    "sepia"
                  ],
                  "description": "dark: light on dark keys, in colour. white, sepia: e-ink looks, dark ink on white or on warm paper."
                },
                "turn": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3,
                  "description": "Quarter turns clockwise from the board's usual landscape: 0 landscape, 1 portrait, 2 and 3 upside down."
                }
              }
            }
          }
        },
        "features": {
          "type": "object",
          "properties": {
            "speaker": {
              "type": "boolean"
            },
            "battery": {
              "type": "boolean"
            },
            "nativeUsb": {
              "type": "boolean"
            },
            "transports": {
              "type": "array",
              "items": {
                "enum": [
                  "ble-hid",
                  "ble-data",
                  "serial",
                  "wifi",
                  "usb-hid"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "incoming": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packetType"
          },
          "uniqueItems": true
        },
        "outgoing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packetType"
          },
          "uniqueItems": true
        }
      },
      "if": {
        "properties": {
          "deviceType": {
            "enum": [
              "board",
              "sim"
            ]
          }
        }
      },
      "then": {
        "required": [
          "board"
        ]
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "layout",
        "name",
        "keys"
      ],
      "properties": {
        "layout": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "source": {
          "enum": [
            "builtin",
            "community",
            "ai",
            "user",
            "default"
          ]
        },
        "reviewed": {
          "type": "boolean"
        },
        "grid": {
          "description": "Columns and rows of this layout; 3x3 when absent. Slots run 1 to cols x rows.",
          "$ref": "#/$defs/grid"
        },
        "page": {
          "description": "Which page this is (1 when absent).",
          "$ref": "#/$defs/pageNumber"
        },
        "pages": {
          "description": "How many pages the layout has (1 when absent); the board shows page dots when more than 1.",
          "$ref": "#/$defs/pageNumber"
        },
        "keys": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "send"
            ],
            "properties": {
              "key": {
                "$ref": "#/$defs/slot"
              },
              "label": {
                "$ref": "#/$defs/label"
              },
              "speak": {
                "type": "string",
                "maxLength": 80
              },
              "icon": {
                "description": "A name from spec/icons.txt, or a picture sent with knoend.image (app:..., site:...); a board that does not know it shows the label alone.",
                "type": "string",
                "pattern": "^([a-z0-9_]{1,40}|(app|site):[a-z0-9._-]{1,60})$"
              },
              "confirm": {
                "type": "boolean"
              },
              "send": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "hid"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "hid": {
                        "type": "object",
                        "required": [
                          "modifiers",
                          "usage"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "modifiers": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 15
                          },
                          "usage": {
                            "type": "integer",
                            "minimum": 4,
                            "maximum": 115
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "event"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "event": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "detail": {
          "description": "Text shown in place of the middle rows of keys (all but the top and bottom), e.g. what a permission request is for. Needs 3 rows or more.",
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "layoutAck": {
      "type": "object",
      "required": [
        "layout",
        "ok"
      ],
      "properties": {
        "layout": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "maxLength": 80
        }
      },
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    "key": {
      "type": "object",
      "required": [
        "key",
        "layout",
        "seq"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/slot"
        },
        "layout": {
          "type": "string"
        },
        "page": {
          "description": "The page the key was on (1 when the layout has one page).",
          "$ref": "#/$defs/pageNumber"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "hid": {
          "type": "object",
          "required": [
            "modifiers",
            "usage"
          ],
          "additionalProperties": false,
          "description": "Present when the board could not type a shortcut key itself (no Bluetooth host): the companion types it.",
          "properties": {
            "modifiers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "usage": {
              "type": "integer",
              "minimum": 4,
              "maximum": 115
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 80
        },
        "level": {
          "enum": [
            "info",
            "attention",
            "alert"
          ]
        },
        "ttl": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "bad-packet",
            "unsupported",
            "too-large",
            "unauthorised",
            "busy"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "pair": {
      "type": "object",
      "required": [
        "companion",
        "key"
      ],
      "description": "Serial only. The board rejects this packet on any other transport.",
      "properties": {
        "companion": {
          "type": "string",
          "pattern": "^[0-9a-z-]{4,64}$"
        },
        "companionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "pairAck": {
      "type": "object",
      "required": [
        "companion",
        "ok"
      ],
      "properties": {
        "companion": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "wifi": {
      "type": "object",
      "required": [
        "ssid",
        "password"
      ],
      "description": "Serial only. The board rejects this packet on any other transport.",
      "properties": {
        "ssid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "password": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "wifiAck": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "wifiNetworks": {
      "type": "object",
      "required": [
        "networks"
      ],
      "properties": {
        "networks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "ssid",
              "rssi",
              "secured"
            ],
            "additionalProperties": false,
            "properties": {
              "ssid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "rssi": {
                "type": "integer",
                "minimum": -127,
                "maximum": 0
              },
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 14
              },
              "secured": {
                "type": "boolean"
              }
            }
          }
        },
        "error": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "image": {
      "description": "A picture for keys (an app's or a site's icon), sent in slices: offset/total in bytes of w*h pixels of RGB565 (byte-swapped) + alpha, 3 bytes each; data is base64 of this slice.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "w",
        "h",
        "offset",
        "total",
        "data"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(app|site):[a-z0-9._-]{1,60}$"
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12288
        },
        "data": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "imageAck": {
      "type": "object",
      "required": [
        "name",
        "ok"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "cols",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "pageNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "page": {
      "type": "object",
      "required": [
        "layout",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "string"
        },
        "to": {
          "enum": [
            "next",
            "prev"
          ]
        }
      }
    },
    "display": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "theme": {
          "enum": [
            "dark",
            "white",
            "sepia"
          ],
          "description": "dark: light on dark keys, in colour. white, sepia: e-ink looks, dark ink on white or on warm paper."
        },
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Quarter turns clockwise from the board's usual landscape: 0 landscape, 1 portrait, 2 and 3 upside down."
        }
      }
    },
    "displayAck": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "enum": [
            "dark",
            "white",
            "sepia"
          ],
          "description": "dark: light on dark keys, in colour. white, sepia: e-ink looks, dark ink on white or on warm paper."
        },
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Quarter turns clockwise from the board's usual landscape: 0 landscape, 1 portrait, 2 and 3 upside down."
        },
        "restarting": {
          "type": "boolean",
          "description": "True when the turn changed: the board restarts to apply it. A new theme is drawn at once."
        }
      },
      "required": [
        "theme",
        "turn",
        "restarting"
      ]
    }
  }
}
