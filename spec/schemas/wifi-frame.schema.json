{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jalabulajunx/openpager/spec/schemas/wifi-frame.schema.json",
  "title": "OpenPager authenticated Wi-Fi frame (protocol v0, draft)",
  "description": "Wraps one packet. mac = hex HMAC-SHA256(K, decimal ctr + newline + packet). See spec/protocol.md section 4.",
  "type": "object",
  "required": ["ctr", "mac", "packet"],
  "additionalProperties": false,
  "properties": {
    "ctr": { "type": "integer", "minimum": 0 },
    "mac": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packet": { "type": "string", "minLength": 2, "maxLength": 4096 }
  }
}
