{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jalabulajunx/knoend/spec/schemas/library.schema.json",
  "title": "KnoEnd layout library (v0, draft)",
  "description": "A TOML layout library, parsed to JSON. Data only: actions are limited to the kinds below. See spec/protocol.md section 5.",
  "type": "object",
  "required": ["pack", "match", "key"],
  "additionalProperties": false,
  "if": { "properties": { "match": { "not": { "required": ["agent"] } } } },
  "then": {
    "description": "Agent answers (action kind agent) only on a coding agent's screen (match.agent); elsewhere the key would do nothing.",
    "properties": { "key": { "items": { "properties": { "action": { "properties": { "kind": { "not": { "const": "agent" } } } } } } } }
  },
  "properties": {
    "pack": {
      "type": "object",
      "required": ["id", "name", "version", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(builtin|community|ai|user)\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source": { "enum": ["builtin", "community", "ai", "user"] },
        "description": { "type": "string", "maxLength": 200 },
        "license": { "type": "string", "maxLength": 64 },
        "authors": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
        "overrides": { "type": "string", "description": "For source = user: id of the library this file layers on." },
        "grid": { "$ref": "#/$defs/grid", "description": "Columns x rows of every page (default 3x3); a [[page]] entry overrides it for one page." },
        "tested": {
          "type": "array", "maxItems": 16,
          "description": "Who saw this recipe work, on which OS and when. An OS not listed is untested there.",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["os", "by", "date"],
            "properties": {
              "os": { "enum": ["linux", "macos", "windows"] },
              "by": { "type": "string", "minLength": 1, "maxLength": 40 },
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "note": { "type": "string", "maxLength": 80, "description": "Desktop, browser or app, e.g. \"Arch Linux, i3 (X11), Firefox\"." }
            }
          }
        }
      }
    },
    "match": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "web": { "$ref": "#/$defs/patterns" },
        "linux": { "$ref": "#/$defs/patterns" },
        "macos": { "$ref": "#/$defs/patterns" },
        "windows": { "$ref": "#/$defs/patterns" },
        "agent": { "$ref": "#/$defs/patterns" },
        "terminal": { "$ref": "#/$defs/patterns", "description": "Programs in the active tab of a terminal app (claude, less), on any OS." }
      }
    },
    "page": {
      "type": "array",
      "maxItems": 8,
      "description": "Settings for one page; pages not listed use pack.grid.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["number", "grid"],
        "properties": {
          "number": { "$ref": "#/$defs/page" },
          "grid": { "$ref": "#/$defs/grid" }
        }
      }
    },
    "key": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["label", "action"],
        "additionalProperties": false,
        "properties": {
          "page": { "$ref": "#/$defs/page" },
          "slot": { "type": "integer", "minimum": 1, "maximum": 16, "description": "1 to cols x rows of the key's page, left to right, top to bottom." },
          "label": { "type": "string", "minLength": 1, "maxLength": 24 },
          "speak": { "type": "string", "maxLength": 80 },
          "icon": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
          "confirm": { "type": "boolean" },
          "action": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false, "required": ["kind", "keys"],
                "properties": {
                  "kind": { "const": "shortcut" },
                  "keys": {
                    "type": "string",
                    "pattern": "^((Primary|Ctrl|Shift|Alt|Meta)\\+)*([A-Z0-9]|F([1-9]|1[0-9]|2[0-4])|Enter|Escape|Tab|Space|Backspace|Delete|Insert|Home|End|PageUp|PageDown|Up|Down|Left|Right|Backquote|Minus|Equal|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Comma|Period|Slash)$"
                  }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["kind", "url"],
                "properties": {
                  "kind": { "const": "open" },
                  "url": { "type": "string", "pattern": "^/([^/]|$)", "maxLength": 512 }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["kind", "selector"],
                "properties": {
                  "kind": { "const": "element" },
                  "selector": { "type": "string", "minLength": 1, "maxLength": 256 }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["kind", "selector"],
                "properties": {
                  "kind": { "const": "focus" },
                  "selector": { "type": "string", "minLength": 1, "maxLength": 256 }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["kind", "command"],
                "properties": {
                  "kind": { "const": "media" },
                  "command": { "enum": ["toggle", "play", "pause", "next", "previous", "mute", "forward", "back"] },
                  "selector": { "type": "string", "minLength": 1, "maxLength": 256 }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["kind", "name"],
                "properties": {
                  "kind": { "const": "command" },
                  "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["kind", "reply"],
                "description": "A key on a coding agent's screen (match.agent): the answer it gives. Keys with reply = option take the agent's options in order.",
                "properties": {
                  "kind": { "const": "agent" },
                  "reply": { "enum": ["allow", "always", "deny", "stop", "option", "done", "decline", "go_to"] }
                }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["kind"],
                "description": "Starts or stops the board listening through its microphone (boards with features.mic); the notes it hears go to the music app as MIDI (spec/protocol.md 3.6f).",
                "properties": {
                  "kind": { "const": "listen" }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "grid": { "type": "string", "pattern": "^[1-4]x[1-4]$" },
    "page": { "type": "integer", "minimum": 1, "maximum": 8 },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    }
  }
}
